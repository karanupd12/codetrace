# Copy to .env and adjust. Never commit .env.
POSTGRES_DB=codetrace
POSTGRES_USER=codetrace
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080
FRONTEND_PORT=3000
CODETRACE_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Worker health (bound to 127.0.0.1) and the optional monitoring tools (docker compose --profile tools up -d)
WORKER_MANAGEMENT_PORT=8081
REDISINSIGHT_PORT=5540
DOZZLE_PORT=8888
